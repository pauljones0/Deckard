# Maintainer: Deckard contributors
pkgname=deckard-git
pkgver=0.8.0.r0
pkgrel=1
pkgdesc='Native Rust controller for Elgato Stream Decks'
arch=('x86_64' 'aarch64')
url='https://github.com/pauljones0/Deckard'
license=('GPL-3.0-or-later')
depends=('glibc' 'systemd-libs' 'libxkbcommon' 'libxkbcommon-x11' 'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'wayland' 'ffmpeg' 'xdg-utils' 'xdotool' 'wtype')
makedepends=('git' 'rust' 'cargo' 'cmake' 'nasm' 'pkgconf')
optdepends=('xdg-desktop-portal: native file dialogs' 'kdotool: KDE automatic page switching')
provides=('deckard')
conflicts=('deckard')
install=deckard-git.install
source=('Deckard::git+https://github.com/pauljones0/Deckard.git#branch=main')
sha256sums=('SKIP')
pkgver() {
  cd "$srcdir/Deckard"
  printf '%s.r%s.g%s' "$(cat VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
build() {
  cd "$srcdir/Deckard"
  cargo build --workspace --release --locked
}
check() {
  cd "$srcdir/Deckard"
  cargo test --workspace --locked
  target/release/deckard --doctor
}
package() {
  cd "$srcdir/Deckard"
  prefix="$pkgdir/usr/lib/deckard"
  install -Dm755 target/release/deckard "$prefix/bin/deckard-bin"
  install -Dm755 packaging/linux/install-udev.sh "$prefix/bin/install-udev.sh"
  install -Dm644 udev.rules "$prefix/share/deckard/60-deckard.rules"
  install -Dm644 udev.rules "$pkgdir/usr/lib/udev/rules.d/60-deckard.rules"
  install -Dm644 examples/plugin/manifest.json "$prefix/share/deckard/plugins/example/manifest.json"
  install -Dm755 target/release/deckard-plugin-example "$prefix/share/deckard/plugins/example/deckard-plugin-example"
  install -Dm644 packaging/linux/deckard.desktop "$pkgdir/usr/share/applications/deckard.desktop"
  install -Dm644 Assets/icons/hicolor/512x512/apps/io.github.nazbert.Deckard.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.nazbert.Deckard.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/deckard/LICENSE"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/deckard/bin/deckard-bin "$pkgdir/usr/bin/deckard"
}
